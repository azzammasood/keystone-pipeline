{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/azzammasood/keystone-pipeline/contracts/backtest_row.schema.json",
  "title": "Keystone backtest row",
  "description": "One incident of the point-in-time backtest (dataset backtest, v1). Misses are reported as misses; 'pending data' means the window is not loaded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "month",
    "cut",
    "summary",
    "sources",
    "outcome",
    "points",
    "sensitivity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "cut": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cut",
          "hour_coverage",
          "status",
          "reference_size",
          "leakage_check",
          "repos"
        ],
        "properties": {
          "cut": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "hour_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reference_size": {
            "type": "integer",
            "minimum": 0
          },
          "leakage_check": {
            "type": [
              "string",
              "null"
            ]
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "repo_id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "status": {
                  "type": "string"
                },
                "fragility": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "percentile": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "flagged": {
                  "type": "boolean"
                },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "available",
                      "sub",
                      "weight",
                      "reason"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "available": {
                        "type": "boolean"
                      },
                      "sub": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sensitivity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "variants",
        "per_repo"
      ],
      "properties": {
        "variants": {
          "type": "integer",
          "minimum": 0
        },
        "per_repo": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scored_variants": {
                "type": "integer"
              },
              "percentile_min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "percentile_max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "flagged_variants": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
