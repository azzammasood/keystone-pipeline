{
  "uid": "keystone-pipeline",
  "title": "Keystone pipeline",
  "tags": [
    "keystone"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Per-run stage numbers and lifetime totals from pipeline_metrics.json (via OpenTelemetry). Live data arrives as hourly files: these are per-run values, not a real-time ticker.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events processed (lifetime)",
      "description": "pipeline_metrics: totals.events_processed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(last_over_time(keystone_pipeline_events_processed[30d]))",
          "instant": true
        }
      ]
    },
    {
