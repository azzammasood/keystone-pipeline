# Copy to .env (git-ignored). Never commit real values.
# Salt for hashing actor ids in silver tables (required to parse; at least 16 characters, random).
# Keep it stable: changing it changes every actor key. Production runs read it from a secret.
KEYSTONE_ACTOR_SALT=
# Optional rungs: leave empty to skip.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
GOOGLE_CLOUD_PROJECT=
OPENROUTER_API_KEY=
